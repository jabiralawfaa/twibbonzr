generator client {
  // prisma-client (default v7) hanya mengeluarkan TypeScript dan wajib punya
  // output; project ini vanilla JS tanpa build step, jadi pakai generator
  // lama yang masih didukung v7 dan men-generate .js ke node_modules.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Sebuah twibbon (template PNG berlubang transparan).
/// Menyimpan metadata + referensi gambar, bukan biner gambar.
/// `imageName` = nama file lokal (data/uploads/) ATAU URL Vercel Blob (https://…).
/// `expiresAt` = createdAt + 14 hari, lewat itu row & file dihapus otomatis.
model Twibbon {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  author      String   @default("Anonim")
  imageName   String
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([createdAt])
  @@index([expiresAt])
}
